<Window x:Class="Jogo4592Radar.ControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="jogo4592radar — Diagnóstico" Width="390" Height="525" MinWidth="350" MinHeight="390" WindowStartupLocation="CenterScreen" Background="#17202B" Foreground="White">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5" /></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,5,8,0" /><Setter Property="Padding" Value="8,5" /></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
    <TextBlock x:Name="VersionHeading" Text="jogo4592radar" FontSize="19" FontWeight="Bold" />
    <TextBlock Text="Recursos capturados ao vivo · posições de jogadores indisponíveis" Foreground="#8EE0AD" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap" />
    <TextBlock Text="Escurecimento do minimapa" />
    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="0.75" Value="0.2" TickFrequency="0.05" ValueChanged="OpacityChanged" />
    <TextBlock x:Name="OpacityText" Text="20%" HorizontalAlignment="Right" />
    <TextBlock Text="Largura do overlay" Margin="0,8,0,5" />
    <Slider x:Name="SizeSlider" Minimum="140" Maximum="400" Value="240" TickFrequency="10" ValueChanged="OverlaySizeChanged" />
    <TextBlock x:Name="SizeText" Text="240 px" HorizontalAlignment="Right" />
    <TextBlock Text="Altura em relação à largura" Margin="0,8,0,5" />
    <Slider x:Name="HeightRatioSlider" Minimum="0.7" Maximum="1.2" Value="0.85" TickFrequency="0.05" ValueChanged="HeightRatioChanged" />
    <TextBlock x:Name="HeightRatioText" Text="85%" HorizontalAlignment="Right" />
    <Button x:Name="LockButton" Content="Travar posição" Click="ToggleLock" HorizontalAlignment="Left" Margin="0,8,0,0" />
    <Separator Margin="0,14,0,12" Background="#495566" />
    <TextBlock Text="CAPTURA NPCAP · DIAGNÓSTICO" FontWeight="Bold" />
    <TextBlock Text="Lê pacotes UDP nas portas 5055, 5056 e 5058 e decodifica eventos Photon. A posição de outros jogadores não foi validada." TextWrapping="Wrap" Foreground="#BEC9D3" />
    <Button x:Name="CaptureButton" Content="Iniciar captura" HorizontalAlignment="Left" Click="ToggleCapture" />
    <CheckBox x:Name="ResourcePreviewCheck" Content="Mostrar recursos capturados" Margin="0,9,0,7" IsChecked="True" />
    <TextBlock x:Name="CaptureStatus" Text="Captura parada." TextWrapping="Wrap" Foreground="#8EE0AD" Margin="0,8,0,0" />
    <TextBlock Text="Raio da prévia (unidades do mapa)" />
    <Slider x:Name="ResourceRadiusSlider" Minimum="20" Maximum="160" Value="80" TickFrequency="10" />
    <TextBlock Text="Rotação da prévia" Margin="0,7,0,5" />
    <Slider x:Name="ResourceRotationSlider" Minimum="-180" Maximum="180" Value="-135" TickFrequency="15" />
    <TextBlock Text="Pontos verdes vêm de eventos de recursos; ajuste raio e rotação para comparar com o minimapa. Nenhum ponto vermelho é desenhado sem posição validada." TextWrapping="Wrap" Foreground="#BEC9D3" Margin="0,8,0,0" />
    <TextBlock Text="Arraste o losango sobre o minimapa e ajuste largura e altura. Depois, trave a posição para os cliques passarem à janela abaixo." TextWrapping="Wrap" Foreground="#BEC9D3" Margin="0,13,0,0" />
  </StackPanel>
  </ScrollViewer>
</Window>
